     "repos": ["nooga/let-go"]},
    {"key": "gate", "name": "Ratchet, baselines & gates",
     "match": "bench-ratchet|ratchet|baseline|A/B|shadow|perf-page|perf gate|pr-fast|measurement status|noise|profile|sticky|bench-baton|quiescence|deterministic bars|empty loop|perf label|comparison|Timeline explorer|CPU filter|bench:",
     "repos": ["nooga/let-go"]},
    {"key": "vm",   "name": "VM hot paths & call ABI",
     "match": "perf\\(vm|feat\\(vm|fix\\(vm|vm:|Frame\\.Run|frame|invoke|PreparedCall|PrepareCall|call ABI|self-call|reduce|dispatch|deref|LazySeq|valueEquiv|keyword lookup|checkedMulInt|timeout channels|BoxedTypes|Int 64|hoist|vector benchmark|ConsCreation|tail calls|perf\\(rt",
     "repos": ["nooga/let-go"]},
    {"key": "ir",   "name": "IR / AOT lowering",
     "match": "perf\\(ir|feat\\(ir|refactor\\(ir|AOT|lowering|lowered|gogen|typeinfer|ir-stress|fusion|native-bridge|natives|parity|interop|fixtures|entry modes|catalog-driven|var loads|OpByKeyword|regex literals|lg compile|native-entry",
     "repos": ["nooga/let-go"]},
    {"key": "foot", "name": "Startup, footprint & targets",
     "match": "startup|footprint|TinyGo|compress|bundle|toolchain|cpuprofile|profiling|lazy var metadata|subs |rune slice|binary|wasm",
     "repos": ["nooga/let-go"]},
    {"key": "xrender", "name": "xsofy: render perf",
     "match": "render|lights|cull|SGR|synchronized|lighttest|frame",
     "repos": ["nooga/xsofy"]},
    {"key": "xbench",  "name": "xsofy: bench & determinism",
     "match": "bench|perf core|replay|microseconds|hash|salt|determin|profiling|Balance",
     "repos": ["nooga/xsofy"]}
  ],
  "default_lane": {"nooga/let-go": "gate", "nooga/xsofy": "xbench"},
