  "user": "mparrett",
  "repos": ["nooga/let-go", "nooga/xsofy"],
  "primary_repo": "nooga/let-go",
  "relevance": "\\b(perf|bench|ratchet|timeline|baseline|noise|regress|alloc|ns/op|geomean|anchor|bisect|profil)\\w*",
