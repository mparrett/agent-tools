#!/usr/bin/env bash
# preview-diff — render a git diff (optionally with a description) to a
# self-contained HTML file and open it in the browser. No server, no deps.
#
# The whole trick: build a throwaway HTML artifact in a temp dir, then `open`
# it. Good for eyeballing a diff/PR candidate locally before pushing.
#
# Usage:
#   preview-diff [base] [head]
#   preview-diff origin/main HEAD
#   preview-diff --body pr-body.md --title "my PR" origin/main
#   preview-diff --show [commit]
#   preview-diff --serve origin/main HEAD
#   preview-diff --review origin/main HEAD
#   git show a b c | preview-diff --from-diff --title "3 commits"
#
# Positional (both optional):
#   base   ref to diff FROM   (default: origin/main if it resolves, else HEAD~1)
#   head   ref to diff TO      (default: HEAD)
#
# Options:
#   --show          render `git show <commit>` instead of a diff; the commit is
#                   the first positional (default: HEAD)
#   --from-diff [f] render a diff you supply instead of generating one — from
#                   file <f>, or stdin if omitted or `-`. The escape hatch for
#                   anything git's own modes don't cover (multi-commit, a
#                   .patch, `gh pr diff`, exotic flags). No repo required.
#   -C <dir>        run git in this repo dir (default: cwd)
#   --body <file>   markdown/text shown above the diff (e.g. a PR description).
#                   Rendered as markdown with a raw/rendered toggle.
#   --title <text>  page title (default: "<base>..<head>", or the commit for --show)
#   -o <file>       output HTML path (default: a temp file)
#   --serve [port]  after writing, serve the file over HTTP (python3 http.server,
#                   default port auto-picked from 8137) and open the http:// URL
#                   instead of a file:// path — handy when a file:// path would be
#                   mangled (e.g. an agent abbreviating the temp dir to an
#                   unclickable ".../…/x.html"). Runs in the FOREGROUND and blocks
#                   until Ctrl-C. For non-interactive use (scripts, agents), pair
#                   with --no-open and background the call to just get the URL:
#                     url=$(preview-diff --serve --no-open HEAD~1 HEAD & sleep 1; ...)
#   --review [port] review mode: same page, plus an overlay for leaving comments
#                   on a line (click its line number) or a span (shift-click a
#                   second line), the review text (markdown) and a reviewer
#                   name. Submit saves a bundle under
#                     $XDG_DATA_HOME/preview-diff/reviews/<id>/
#                   holding review.md (the review, postable as-is with
#                   `gh pr comment N --body-file`, and the small file to point
#                   an agent at), review.json, review.html (self-contained page)
#                   and source.diff. Implies --serve, since submitting POSTs
#                   to the server; same foreground/Ctrl-C behaviour.
#                   Agents can skip the browser and POST the same JSON directly:
#                     curl -X POST -H 'Content-Type: application/json' \
#                          -d @review.json http://127.0.0.1:PORT/review
#                   {"reviewer":"me","body":"the review, markdown","comments":[
#                     {"path":"a.py","line":42,"side":"new","body":"..."},
#                     {"path":"a.py","start_line":10,"line":14,"body":"span"}]}
#   --review-out <dir>  save reviews here instead of the XDG location
#   --no-open       write the file but don't launch the browser
#   -h, --help      this help

set -euo pipefail

repo="."
body_file=""
title=""
out=""
do_open=1
serve=0
serve_port=""
show_mode=0
from_diff=0
diff_src="-"
review=0
review_out=""
pos=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --show)    show_mode=1; shift ;;
    # Optional value: consume the next arg as the source file unless it's
    # another option, so bare `--from-diff` (and `--from-diff -`) mean stdin.
    --from-diff)
      from_diff=1
      if [[ -n "${2-}" && ( "$2" == "-" || "$2" != -* ) ]]; then diff_src="$2"; shift 2; else shift; fi ;;
    -C)        repo="$2"; shift 2 ;;
    --body)    body_file="$2"; shift 2 ;;
    --title)   title="$2"; shift 2 ;;
    -o)        out="$2"; shift 2 ;;
    --serve)
      serve=1
      if [[ -n "${2-}" && "$2" =~ ^[0-9]+$ ]]; then serve_port="$2"; shift 2; else shift; fi ;;
    # Review implies serve: the comment overlay submits over HTTP, so there has
    # to be something listening to submit to.
    --review)
      review=1; serve=1
      if [[ -n "${2-}" && "$2" =~ ^[0-9]+$ ]]; then serve_port="$2"; shift 2; else shift; fi ;;
    --review-out) review_out="$2"; shift 2 ;;
    --no-open) do_open=0; shift ;;
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//;/^set -euo/d'; exit 0 ;;
    -*)        echo "preview-diff: unknown option $1" >&2; exit 2 ;;
    *)         pos+=("$1"); shift ;;
  esac
done

# Resolve the real script dir through any symlinks (bin/preview-diff is a
# symlink) so we can find the vendored markdown renderer next to the script.
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
script_dir="$(cd -P "$(dirname "$src")" && pwd)"
# micromd: a tiny self-built Markdown→HTML renderer, stored pre-minified and
# base64'd so it embeds as a data: URL <script> with no build step at runtime.
md_b64="$script_dir/vendor/micromd.min.js.b64"
review_server="$script_dir/review_server.py"

git_repo() { git -C "$repo" "$@"; }

# --serve support: probe/pick a free localhost port with bash's /dev/tcp (no nc).
port_free() { ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
find_free_port() {
  local base="${1:-8137}" p
  for ((p = base; p < base + 50; p++)); do port_free "$p" && { echo "$p"; return 0; }; done
  return 1
}

# --from-diff is a pure renderer, so it needs no repo; every other mode drives
# git and does.
[[ $from_diff -eq 1 ]] || git_repo rev-parse --git-dir >/dev/null 2>&1 || { echo "preview-diff: $repo is not a git repo" >&2; exit 1; }
[[ -n "$body_file" && ! -f "$body_file" ]] && { echo "preview-diff: no such body file: $body_file" >&2; exit 1; }
if [[ $review -eq 1 ]]; then
  command -v python3 >/dev/null || { echo "preview-diff: --review needs python3" >&2; exit 1; }
  [[ -f "$review_server" ]] || { echo "preview-diff: missing review server: $review_server" >&2; exit 1; }
fi

# Resolve what to render. With --from-diff the diff is supplied (stdin or a
# file); stats come from our own parse, so no repo is needed.
# In --show mode it's a single commit (the first positional, default HEAD) fed
# to `git show`. Otherwise it's a diff: accept either two refs (base head) or a
# single git range arg, so both `preview-diff origin/main HEAD` and the
# muscle-memory `preview-diff origin/main..HEAD` (or A...B) work. Bare:
# origin/main if it resolves, else HEAD~1, vs HEAD.
if [[ $from_diff -eq 1 ]]; then
  label="diff"
  if [[ "$diff_src" == "-" ]]; then diff="$(cat)"; else
    [[ -f "$diff_src" ]] || { echo "preview-diff: no such diff file: $diff_src" >&2; exit 1; }
    diff="$(cat "$diff_src")"
  fi
  [[ -z "$diff" ]] && { echo "preview-diff: empty diff input" >&2; exit 0; }
elif [[ $show_mode -eq 1 ]]; then
  commit="${pos[0]:-HEAD}"
  # A merge shows an empty combined diff unless conflicted; diff it against its
  # first parent instead so the merge's changes actually render.
  if git_repo rev-parse --verify -q "$commit^2" >/dev/null 2>&1; then
    diff="$(git_repo show --first-parent -m "$commit")"
  else
    diff="$(git_repo show "$commit")"
  fi
  [[ -z "$diff" ]] && { echo "preview-diff: no output for ${commit}" >&2; exit 0; }
  # Pull the commit metadata separately (the awk parser skips the git-show
  # preamble): subject titles the page, author·date + body surface in the header.
  show_subject="$(git_repo show -s --format=%s "$commit" 2>/dev/null || true)"
  show_meta="$(git_repo show -s --format='%an · %ad' --date=short "$commit" 2>/dev/null || true)"
  show_body="$(git_repo show -s --format=%b "$commit" 2>/dev/null || true)"
  show_short="$(git_repo rev-parse --short "$commit" 2>/dev/null || echo "$commit")"
  label="${show_subject:-$commit}"
else
  base="${pos[0]:-}"
  head="${pos[1]:-}"
  if [[ -n "$base" && -z "$head" && "$base" == *".."* ]]; then
    range=("$base"); label="$base"
  else
    [[ -z "$base" ]] && { git_repo rev-parse --verify -q origin/main >/dev/null && base="origin/main" || base="HEAD~1"; }
    [[ -z "$head" ]] && head="HEAD"
    range=("$base" "$head"); label="${base}..${head}"
  fi
  diff="$(git_repo diff "${range[@]}")"
  [[ -z "$diff" ]] && { echo "preview-diff: no diff for ${label}" >&2; exit 0; }
fi
[[ -z "$title" ]] && title="$label"

# mktemp owns the unique name; rename it to .html so the browser renders it as
# HTML (and so we don't orphan the original 0-byte temp file). In --serve mode we
# instead drop the file as index.html in a dedicated dir, so the served root is
# clean (http://127.0.0.1:PORT/) and sibling temp files aren't listed.
#
# Every mktemp here spells its template out rather than using `-t`: BSD mktemp
# reads -t's argument as a prefix, GNU coreutils reads it as a template and
# rejects one with no XXX in it. On Linux the -t form aborts the script under
# `set -e` before it prints anything, so --serve and --review died silently.
# Set unconditionally — the review-mode temp below needs it even when -o
# supplied the output path, and `set -u` makes an unset one fatal.
tmproot="${TMPDIR:-/tmp}"; tmproot="${tmproot%/}"
if [[ -z "$out" ]]; then
  if [[ $serve -eq 1 ]]; then
    servedir="$(mktemp -d "$tmproot/preview-diff-serve.XXXXXX")"; out="$servedir/index.html"
  else
    tmp="$(mktemp "$tmproot/preview-diff.XXXXXX")"; out="$tmp.html"; mv "$tmp" "$out"
  fi
fi

esc() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }

# One unified-diff parser for everything derived from the diff. mode=render
# emits the per-file HTML cards; mode=stats emits "add<TAB>del<TAB>path" per
# file. The totals and changed-files chips come from the same parse as the
# cards, so they can't disagree with what's rendered (counts, order, #file-N
# anchors) — which they could when numstat came from a second git invocation.
awk_prog='
    function esc(s){ gsub(/&/,"\\&amp;",s); gsub(/</,"\\&lt;",s); gsub(/>/,"\\&gt;",s); return s }
    # Attribute values additionally need the quote closed off, or a path
    # containing one would break out of the attribute.
    function escattr(s){ s=esc(s); gsub(/"/,"\\&quot;",s); return s }
    function langof(path,   ext){
      ext=path; sub(/.*\./,"",ext)
      if(ext ~ /^(js|mjs|cjs|jsx)$/) return "javascript"
      if(ext ~ /^(ts|tsx)$/) return "typescript"
      if(ext=="py") return "python"
      if(ext ~ /^(ex|exs|eex|heex)$/) return "elixir"
      if(ext=="rs") return "rust"
      if(ext=="go") return "go"
      if(ext=="rb") return "ruby"
      if(ext ~ /^(sh|bash|zsh)$/) return "shell"
      if(ext=="md") return "markdown"
      if(ext ~ /^(yml|yaml)$/) return "yaml"
      if(ext=="json") return "json"
      if(ext=="html") return "html"
      if(ext=="css") return "css"
      return ""
    }
    # Bucket a changed file so the header can show implementation lines by
    # default and disclose the total. Path rules only — no content analysis, no
    # config. First match wins. Regular .json/.edn/.yaml/.toml stay
    # implementation on purpose; only generated lockfiles are assets.
    function catof(path,   ext,base){
      base=path; sub(/.*\//,"",base)
      ext=base; sub(/.*\./,"",ext); ext=tolower(ext)
      if(path ~ /(^|\/)(tests?|spec|__tests__)\//) return "tests"
      if(base ~ /(_test\.|\.test\.|_spec\.|\.spec\.)/) return "tests"
      if(base ~ /^test_/) return "tests"
      if(path ~ /(^|\/)docs?\//) return "docs"
      if(ext ~ /^(md|mdx|rst|txt|adoc|org)$/) return "docs"
      # Anchored: these only need to catch the extensionless spellings, since
      # CHANGELOG.md and friends already matched the extension rule above. As a
      # bare prefix it also swallowed ordinary source — NOTICEBOARD.js and
      # AUTHORS_NOTE.py both classified as docs and left the headline count.
      if(base ~ /^(LICEN[CS]E|COPYING|NOTICE|CHANGELOG|AUTHORS|CONTRIBUTORS)(\.|$)/) return "docs"
      if(base ~ /^(package-lock\.json|npm-shrinkwrap\.json|yarn\.lock|pnpm-lock\.yaml|go\.sum|Cargo\.lock|poetry\.lock|Gemfile\.lock|composer\.lock|uv\.lock|flake\.lock)$/) return "assets"
      if(base ~ /\.min\.(js|css)$/) return "assets"
      if(ext ~ /^(png|jpe?g|gif|webp|bmp|ico|svg|pdf|woff2?|ttf|otf|eot|zip|gz|tgz|tar|bz2|xz|mp4|mov|webm|mp3|wav|wasm|so|dylib|dll|bin|map|lock)$/) return "assets"
      return "implementation"
    }
    function bar(a,d,   g,r,s,out,i){
      s=a+d; g=0; r=0
      if(s>0){ g=int((a*5 + s/2)/s); if(a>0&&g==0)g=1; if(d>0&&g==5)g=4; r=5-g }
      out=""
      for(i=0;i<g;i++) out=out "<i class=\"g\"></i>"
      for(i=0;i<r;i++) out=out "<i class=\"r\"></i>"
      return out
    }
    # Strip git quoting ("..."), an a/ or b/ prefix, and a trailing tab+timestamp
    # (plain diff), so both git and POSIX unified-diff paths land clean.
    function cleanpath(s){ sub(/\t.*$/,"",s); if(s ~ /^".*"$/) s=substr(s,2,length(s)-2); sub(/^[ab]\//,"",s); return s }
    function startfile(p){ flush(); fileno++; path=p; add=0; del=0; rows=""; ln_o=0; ln_n=0; infile=1 }
    function emit(line,   c){
      if(!infile) return
      if(line ~ /^@@/){
        match(line,/-[0-9]+/); ln_o=substr(line,RSTART+1,RLENGTH-1)+0
        match(line,/\+[0-9]+/); ln_n=substr(line,RSTART+1,RLENGTH-1)+0
        rows=rows "<tr class=\"r-hunk\"><td class=\"ln ln-o\"></td><td class=\"ln ln-n\"></td><td class=\"code\">" esc(line) "</td></tr>"
        return
      }
      c=substr(line,2)
      # data-o/data-n are what the review overlay anchors to: they name the
      # (side, line) a comment attaches to, apart from how the row is rendered.
      if(line ~ /^\+/){ add++; rows=rows "<tr class=\"r-add\" data-n=\"" ln_n "\"><td class=\"ln ln-o\"></td><td class=\"ln ln-n\">" ln_n "</td><td class=\"code\"><span class=\"sign\">+</span>" esc(c) "</td></tr>"; ln_n++; return }
      if(line ~ /^-/){ del++; rows=rows "<tr class=\"r-del\" data-o=\"" ln_o "\"><td class=\"ln ln-o\">" ln_o "</td><td class=\"ln ln-n\"></td><td class=\"code\"><span class=\"sign\">-</span>" esc(c) "</td></tr>"; ln_o++; return }
      if(line ~ /^ /){ rows=rows "<tr data-o=\"" ln_o "\" data-n=\"" ln_n "\"><td class=\"ln ln-o\">" ln_o "</td><td class=\"ln ln-n\">" ln_n "</td><td class=\"code\"><span class=\"sign\"> </span>" esc(c) "</td></tr>"; ln_o++; ln_n++; return }
    }
    function flush(   lang,cat){
      if(!infile) return
      infile=0
      cat=catof(path)
      # stats mode carries the category as a third field so the header totals and
      # the changed-files chips classify from the same parse as the cards.
      if(mode=="stats"){ printf "%d\t%d\t%s\t%s\n", add, del, cat, path; return }
      lang=langof(path)
      printf "<details class=\"file\" id=\"file-%d\" data-path=\"%s\" open><summary class=\"file-head\"><div class=\"file-name\"><span class=\"chev\"></span>", fileno, escattr(path)
      if(lang!="") printf "<span class=\"lang\" data-lang=\"%s\">%s</span>", lang, lang
      printf "<h2>%s</h2></div>", esc(path)
      printf "<div class=\"file-stat\">"
      # Implementation is the default and carries no tag; tests/docs/assets do.
      if(cat!="implementation") printf "<span class=\"file-cat cat-%s\">%s</span>", cat, cat
      printf "<span class=\"add\">+%d</span> <span class=\"del\">-%d</span> <span class=\"bar\">%s</span></div></summary>", add, del, bar(add,del)
      printf "<div class=\"code-wrap\"><table class=\"diff\">%s</table></div></details>\n", rows
    }
    # A plain-diff "--- " is only a file header if the next line is "+++ "; decide here
    # (the line after the stashed "--- "). Otherwise it was a "-- x" content del line.
    maybe_header==1 {
      maybe_header=0
      if($0 ~ /^\+\+\+ /){ startfile(cleanpath(substr($0,5))); next }
      emit(pending_old)   # stashed line was content; fall through to process this one
    }
    /^diff --git / { saw_git=1; p=$0; sub(/^diff --git /,"",p); sub(/^.* /,"",p); startfile(cleanpath(p)); pend=1; next }
    /^index / { next }
    /^rename to / { if(infile) path=cleanpath(substr($0,11)); next }
    /^--- / {
      if(pend) next                        # git header (old side)
      if(saw_git){ emit($0); next }         # git-mode content collision (-- x)
      pending_old=$0; maybe_header=1; next  # plain diff: confirm against the next line
    }
    /^\+\+\+ / {
      if(pend){ pend=0; p=cleanpath(substr($0,5)); if(p!="/dev/null" && p!="") path=p; next }
      emit($0); next                        # content collision (++ y)
    }
    infile==0 { next }
    /^@@/ { emit($0); next }
    /^\+/ { emit($0); next }
    /^-/  { emit($0); next }
    /^ /  { emit($0); next }
    /^\\/ { next }
    { next }
    END { flush() }
'
parse_diff() { printf '%s\n' "$diff" | awk -v mode="$1" "$awk_prog"; }

numstat="$(parse_diff stats)"

files_n=0; add_n=0; del_n=0; impl_files=0; impl_add=0; impl_del=0
while IFS=$'\t' read -r a d c p; do
  [[ -z "${p:-}" ]] && continue
  files_n=$((files_n + 1))
  add_n=$((add_n + a))
  del_n=$((del_n + d))
  if [[ "$c" == implementation ]]; then
    impl_files=$((impl_files + 1))
    impl_add=$((impl_add + a))
    impl_del=$((impl_del + d))
  fi
done <<< "$numstat"

# eyebrow + base→head refs by mode
if [[ $show_mode -eq 1 ]]; then eyebrow="commit"; base_ref=""; head_ref="${show_short:-$commit}"
elif [[ "$label" == *..* ]]; then eyebrow="branch review"; base_ref="${label%%..*}"; head_ref="${label##*..}"
else eyebrow="diff review"; base_ref=""; head_ref=""
fi

# A 5-square bar split green/red by the add:del ratio (both get ≥1 when nonzero).
bar_html() {
  local a="$1" d="$2" tot=5 g r i out=""
  local sum=$((a + d))
  if [[ $sum -eq 0 ]]; then g=0; r=0
  else
    g=$(( (a * tot + sum / 2) / sum ))
    [[ $a -gt 0 && $g -eq 0 ]] && g=1
    [[ $d -gt 0 && $g -ge $tot ]] && g=$((tot - 1))
    r=$((tot - g))
  fi
  for ((i = 0; i < g; i++)); do out+='<i class="g"></i>'; done
  for ((i = 0; i < r; i++)); do out+='<i class="r"></i>'; done
  printf '%s' "$out"
}

{
  echo '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>'"$(printf '%s' "$title" | esc)"'</title>'
  cat <<'CSS'
<style>
:root{
  --ground:#0f1419; --surface:#171d23; --code-bg:#1a2027; --border:#2a333c;
  --text:#c9d3de; --muted:#7d8896; --faint:#59636e;
  --accent:#4fd6be; --add:#3fb950; --del:#f85149; --hunk:#58a6ff;
  --add-bg:rgba(63,185,80,.10); --del-bg:rgba(248,81,73,.10);
  --add-gutter:rgba(63,185,80,.28); --del-gutter:rgba(248,81,73,.28);
  /* Clearance under the sticky header for anything scrolled to. Measured
     from the real header at load — it grows with a wrapped title or an
     extra ref line, and a stale guess buries whatever you jumped to. */
  --anchor:164px;
  --mono:ui-monospace,SFMono-Regular,"JetBrains Mono",Menlo,Consolas,monospace;
  --sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
*{box-sizing:border-box}
/* text-size-adjust:100% stops iOS/mobile from auto-inflating the code text —
   the browser boosts blocks it reads as "main content" (the wide diff) while
   leaving the chrome alone, so the code renders disproportionately large. */
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{margin:0;background:var(--ground);color:var(--text);font-family:var(--sans);line-height:1.5;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px 96px}
.top{position:sticky;top:0;z-index:10;background:rgba(15,20,25,.86);backdrop-filter:blur(8px);border-bottom:1px solid var(--border);margin:0 -20px 0;padding:18px 20px 16px}
.eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:600;display:flex;gap:10px;align-items:center}
.eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px var(--accent)}
h1{font-size:23px;margin:8px 0 0;font-weight:650;letter-spacing:-.01em;text-wrap:balance}
.refs{margin-top:6px;font-family:var(--mono);font-size:12.5px;color:var(--muted)}
.refs b{color:var(--text);font-weight:600}
.refs .arrow{color:var(--faint);margin:0 6px}
.cmeta{margin-top:5px;font-family:var(--mono);font-size:12px;color:var(--faint)}
.totals{display:flex;gap:18px;margin-top:14px;font-family:var(--mono);font-size:13px;font-variant-numeric:tabular-nums;align-items:center;flex-wrap:wrap}
.totals .k{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.08em;margin-right:6px}
.totals a{border-bottom:1px dotted var(--faint)}
.totals a:hover{border-bottom-color:var(--accent)} .totals a:hover .k{color:var(--accent)}
.keys{margin-left:auto;font-size:10.5px;color:var(--faint);letter-spacing:.02em}
.keys b{color:var(--muted);font-weight:600}
.keys .sep{margin:0 6px;opacity:.5}
.add{color:var(--add)} .del{color:var(--del)}
.desc{margin:22px 0 0;scroll-margin-top:var(--anchor)}
.desc-head{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:10px;display:flex;align-items:center;gap:10px}
/* Typography above is shared with the review header, which is a plain div and
   must not look clickable; the interactive half hangs off summary. */
summary.desc-head{cursor:pointer;list-style:none;margin:0;padding:6px 0}
summary.desc-head::-webkit-details-marker{display:none}
summary.desc-head:hover{color:var(--text)}
details.desc[open] summary.desc-head{margin:0 0 8px}
details.desc[open] .chev{transform:rotate(90deg)}
