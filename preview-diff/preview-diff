       if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(text).then(ok,function(){}); return; }
       var t=document.createElement('textarea'); t.value=text;
       document.body.appendChild(t); t.select();
       try{ document.execCommand('copy'); ok(); }catch(e){}
       t.remove();
     };
     return b;
   }
   function done(r){
     submitBtn.disabled=false;
     // Lead with the markdown: it is what gets posted, and what an agent should
     // be pointed at. The html is the same review with the whole diff around it.
     say('ok','Review saved → '+r.review_md);
     var hint=document.createElement('div');
     hint.style.color='var(--muted)'; hint.style.marginTop='4px';
     hint.textContent='gh pr comment <n> --body-file '+r.review_md;
     msgEl.appendChild(hint);
     var page=document.createElement('div');
     page.style.color='var(--muted)'; page.style.marginTop='4px';
     // A file:// link cannot be followed from an http:// page, so hand over the
     // path rather than pretending it is clickable.
     page.textContent='Full page (self-contained): '+r.review_html;
     msgEl.appendChild(page);
     msgEl.appendChild(copyButton(r.review_md));
   }

   // The review box starts folded — it is fixed to the bottom of every screen,
   // and most of a review is spent reading. `r` and the comment count open it.
   // A folded box still holds whatever was typed, so say so rather than let the
   // text vanish.
   var rvBar=document.getElementById('rv-bar');
   var draftEl=document.getElementById('rv-draft');
   function markDraft(){
     if(draftEl) draftEl.hidden = !(rvBar.classList.contains('rv-fold') && generalEl.value.trim());
   }
   function foldReview(v){
     rvBar.classList.toggle('rv-fold', v);
     if(v){ generalEl.blur(); } else { generalEl.focus(); }
     markDraft();
   }
   // `r` only ever opens: once focus is in the box the global handler ignores
   // it, so a toggle would close from outside and type an "r" from inside.
   // Esc closes, and the count is a click-toggle for the mouse.
   window.pdOpenReview=function(){ foldReview(false); };
   var foldToggle=document.getElementById('rv-fold-toggle');
   if(foldToggle) foldToggle.onclick=function(){ foldReview(!rvBar.classList.contains('rv-fold')); };
   generalEl.addEventListener('input', markDraft);
   generalEl.addEventListener('keydown', function(e){
     // Matches the line-comment editor, which has had both since it shipped.
     if((e.metaKey||e.ctrlKey) && e.key==='Enter'){ e.preventDefault(); submitBtn.click(); }
     else if(e.key==='Escape'){ e.preventDefault(); foldReview(true); }
   });

   submitBtn.onclick=function(){
     var general=(generalEl.value||'').trim();
     if(!comments.length && !general){
       say('err','Nothing to submit yet — add a line comment or a general comment.');
       return;
     }
     var payload={
       reviewer:(nameInput.value||'').trim(),
       body:general,
       comments:comments.map(function(c){
         return {path:c.path, file_id:c.file_id, side:c.side,
                 start_line:c.start_line, line:c.line, body:c.body};
       })
     };
     try{ localStorage.setItem('preview-diff.reviewer', payload.reviewer); }catch(e){}
     submitBtn.disabled=true;
     say('','Submitting…');
     fetch('/review', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)})
       .then(function(r){ return r.json().then(function(j){ return {ok:r.ok, j:j}; },
                                              function(){ return {ok:false, j:{error:'server sent a non-JSON reply'}}; }); })
       .then(function(res){
         if(!res.ok){ submitBtn.disabled=false; say('err', res.j.error||'submit failed'); return; }
         done(res.j);
       })
       .catch(function(e){
         submitBtn.disabled=false;
         say('err','Could not reach the review server: '+e.message);
       });
   };
   updateCount();
 })();
</script>
RVJS
  fi

  if [[ -n "$body_file" && -f "$body_file" && $need_md -eq 1 ]]; then
    cat <<'JS'
<script>
 (function(){
   var raw=document.getElementById('md-raw'), out=document.getElementById('md-rendered'), btn=document.getElementById('md-toggle');
   pdRenderMd(out, raw.textContent);
   var showRaw=false;
   // The button sits in the Description <summary>, so a default click would
   // also collapse the block it is switching the view of.
   btn.onclick=function(e){ e.preventDefault(); e.stopPropagation(); showRaw=!showRaw; raw.hidden=!showRaw; out.hidden=showRaw; btn.textContent=showRaw?'rendered':'raw'; };
 })();
</script>
JS
  fi
  echo '</body></html>'
} > "$out"

# --serve: hand the artifact to python's http.server on loopback and hold the
# process open (Ctrl-C to stop). Emitting an http:// URL instead of a file path
# sidesteps the abbreviated-path linkify problem entirely.
if [[ $serve -eq 1 ]]; then
  command -v python3 >/dev/null || { echo "preview-diff: --serve needs python3" >&2; exit 1; }
  dir="$(dirname "$out")"; file="$(basename "$out")"
  [[ "$file" == "index.html" ]] && urlpath="" || urlpath="$file"

  # In review mode the artifact is served by our own handler instead, because
  # http.server answers GET only and a submission is a POST. The diff is stashed
  # so a saved review carries what it reviewed.
  if [[ $review -eq 1 ]]; then
    # Not "$dir/source.diff": with -o that directory is the user's, and a file
    # of that name there is theirs to keep.
    review_diff="$(mktemp "$tmproot/preview-diff-src.XXXXXX")"
    trap 'rm -f "$review_diff"' EXIT
    printf '%s\n' "$diff" > "$review_diff"
    review_args=(--dir "$dir" --page "$file" --diff "$review_diff"
                 --title "$title" --base "$base_ref" --head "$head_ref")
    [[ -n "$review_out" ]] && review_args+=(--out-root "$review_out")
    # The review server answers the page at /, whatever it is called on disk.
    urlpath=""
  fi

  # Launch on $1 and wait until OUR child holds the listener. "Port busy" alone
  # is not readiness — a foreign listener passes that check while the child dies
  # on the failed bind, and the printed URL would point at the wrong service.
  start_server() {
    if [[ $review -eq 1 ]]; then
      python3 "$review_server" --port "$1" --bind 127.0.0.1 "${review_args[@]}" >&2 &
    else
      python3 -m http.server "$1" --bind 127.0.0.1 --directory "$dir" >/dev/null 2>&1 &
    fi
    srv=$!
    # Re-state the temp-diff cleanup: this trap replaces the one set above.
    trap 'kill "$srv" 2>/dev/null; rm -f "${review_diff:-}"' EXIT INT TERM
    for _ in $(seq 1 50); do
      kill -0 "$srv" 2>/dev/null || return 1   # child died: bind failed
      port_free "$1" || return 0               # listener up, child alive: ours
      sleep 0.1
    done
    kill "$srv" 2>/dev/null
    return 1
  }

  if [[ -n "$serve_port" ]]; then
    # Explicit port: preflight and fail loud — silently serving elsewhere would
    # contradict what the user asked for.
    port="$serve_port"
    port_free "$port" || { echo "preview-diff: port $port is already in use" >&2; exit 1; }
    start_server "$port" || { echo "preview-diff: could not serve on port $port" >&2; exit 1; }
  else
    # Auto-picked port: another process can win the race between find_free_port
    # and the bind; pick again and retry.
    started=0
    for _ in 1 2 3; do
      port="$(find_free_port)" || { echo "preview-diff: no free port in 8137..8186" >&2; exit 1; }
      start_server "$port" && { started=1; break; }
    done
    [[ $started -eq 1 ]] || { echo "preview-diff: could not start http.server after 3 attempts" >&2; exit 1; }
  fi

  url="http://127.0.0.1:$port/$urlpath"
  echo "$url"
  if [[ $review -eq 1 ]]; then
    echo "preview-diff: review at $url — submit posts to http://127.0.0.1:$port/review — Ctrl-C to stop" >&2
    echo "preview-diff: reviews save to ${review_out:-${XDG_DATA_HOME:-$HOME/.local/share}/preview-diff/reviews}" >&2
  else
    echo "preview-diff: serving on $url — Ctrl-C to stop" >&2
  fi
  if [[ $do_open -eq 1 ]]; then
    if command -v open >/dev/null; then open "$url"
    elif command -v xdg-open >/dev/null; then xdg-open "$url"; fi
  fi
  wait "$srv"
  exit 0
fi

echo "$out"
if [[ $do_open -eq 1 ]]; then
  if command -v open >/dev/null; then open "$out"
  elif command -v xdg-open >/dev/null; then xdg-open "$out"
  else echo "preview-diff: no opener (open/xdg-open); file written above" >&2
  fi
fi
