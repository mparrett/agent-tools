{
  "modules": ["./register.tsx"],
  "hooks": {
    "SessionStart": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/../session_start_hook.py", "args": [], "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/../session_end_hook.py", "args": [], "timeout": 25 }] }
    ]
  }
}
